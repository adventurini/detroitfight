{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.detroitfight.com"
        }
      ],
      "destination": "https://detroitfight.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/camp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kids-camp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
