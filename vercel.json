{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.detroitfight.com"
        }
      ],
      "destination": "https://detroitfight.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/review",
      "destination": "https://g.page/r/CZv88maAzdT4EBM/review",
      "permanent": false
    },
    {
      "source": "/camp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kids-camp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
